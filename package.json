{
  "name": "@home-mandate/spec",
  "version": "0.1.0-alpha.1",
  "homeMandateSpec": "v0.1.0-alpha.1",
  "description": "Independent TypeScript implementation of the Home-Mandate Specification v0: validation, digest, evaluation, selection, audit log verification, signatures.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "exports": { ".": "./src/index.ts", "./browser": "./src/browser.ts" },
  "bin": { "mandate-harness-ts": "./src/harness.ts" },
  "scripts": {
    "test": "node --test test/*.test.ts && node --disallow-code-generation-from-strings --test test/browser.test.ts",
    "typecheck": "tsc --noEmit",
    "harness": "node src/harness.ts",
    "sync-spec": "node scripts/sync-spec.ts",
    "generate": "node scripts/generate-validators.ts"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "ajv": "8.20.0",
    "typescript": "5.8.3"
  }
}
